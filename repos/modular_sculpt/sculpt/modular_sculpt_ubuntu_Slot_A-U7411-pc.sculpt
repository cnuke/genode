deploy:   modular_sculpt_ubuntu_Slot_A-U7411
gpu:      empty
manager:  modular_sculpt
network:  modular_sculpt
platform: u7411
ram_fs:   modular_sculpt
system:   pc
usb:      Slot_A

import: pkg/sculpt_drivers-pc
import: raw/vbox_files

option: sculpt
option: acpi_support
option: black_hole
option: system_clock

option: window_manager

option: touchpad_u7411
option: sof_audio audio_mixer

option: system_shell
option: nvme_drv storage_nvme

option: usb_webcam

option: vm_ubuntu_nvme_Slot_A
