<config arch="x86_64">

	<common_routes>
		<service name="ROM" label_last="ld.lib.so"> <parent/> </service>
		<service name="CPU">   <parent/> </service>
		<service name="PD">    <parent/> </service>
		<service name="LOG">   <parent/> </service>
		<service name="Timer"> <parent/> </service>
	</common_routes>
	<default-route>
		<service name="Timer"> <parent/> </service>
		<any-service> <parent/> <any-child/> </any-service>
	</default-route>

	<start name="acpi_support"/>
	<start name="black_hole"/>
	<start name="system_clock"/>
	<start name="fonts_fs"/>
	<start name="default_recall_fs"/>

	<start name="window_layouter"/>
	<start name="themed_decorator"/>
	<start name="wm"/>

	<start name="mesa_gpu-intel" pkg="mesa_gpu-intel" priority="-2">
		<route>
			<service name="RM"> <parent/> </service>
		</route>
	</start>

	<start name="default_fs_shell"/>

	<start name="mixer">
		<config jitter_ms="10" warning_rate_ms="0">
			<mix name="left">
				<play label="vm_ubuntu_ahci_Slot_B -> left"  volume="0.5"/>
				<play label="vm_windows_ahci_Slot_A -> left" volume="0.5"/>
			</mix>
			<mix name="right">
				<play label="vm_ubuntu_ahci_Slot_B -> right"  volume="0.5"/>
				<play label="vm_windows_ahci_Slot_A -> right" volume="0.5"/>
			</mix>

			<mix name="mic_left">  <play label="sof_audio -> mic_left"/>  </mix>
			<mix name="mic_right"> <play label="sof_audio -> mic_right"/> </mix>

			<policy label="vm_ubuntu_ahci_Slot_B -> left"   record="mic_left"  period_ms="46" jitter_ms="23" volume="1.0"/>
			<policy label="vm_ubuntu_ahci_Slot_B -> right"  record="mic_right" period_ms="46" jitter_ms="23" volume="1.0"/>
			<policy label="vm_windows_ahci_Slot_A -> left"  record="mic_left"  period_ms="46" jitter_ms="23" volume="1.0"/>
			<policy label="vm_windows_ahci_Slot_A -> right" record="mic_right" period_ms="46" jitter_ms="23" volume="1.0"/>

			<policy label="bsd_audio -> left"   record="left"  period_ms="12" jitter_ms="5" volume="1.0"/>
			<policy label="bsd_audio -> right"  record="right" period_ms="12" jitter_ms="5" volume="1.0"/>
		</config>
	</start>
	<start name="bsd_audio"/>

	<start name="usb_webcam"/>

	<start name="ahci"/>
	<start name="storage_ahci"/>

	<start name="vm_ubuntu_ahci_Slot_B"/>

	<start name="vm_windows_ahci_Slot_A"/>

</config>
