assert {[have_spec linux]}

# check that babeltrace2 is present
set babeltrace_missing [catch {
	spawn babeltrace2 -V
	expect {
		{Babeltrace 2.*}  { }
		eof { return }
		timeout { return }
	}
}]

if {$babeltrace_missing} {
	puts "\nPlease install babeltrace2 on your host system."
	exit 1;
}

build { server/lx_fs }

create_boot_directory

import_from_depot \
	[depot_user]/src/[base_src] \
	[depot_user]/src/init \
	[depot_user]/src/libc \
	[depot_user]/src/rom_logger \
	[depot_user]/src/report_rom \
	[depot_user]/src/vfs \
	[depot_user]/src/dummy_rtc \
	[depot_user]/src/trace_recorder \
	[depot_user]/raw/trace_recorder \
	[depot_user]/src/trace_recorder_policy \
	[depot_user]/src/dynamic_rom

install_config {
config | verbose: yes
+ parent-provides
  + service ROM
  + service LOG
  + service RM
  + service CPU
  + service PD
  + service IRQ
  + service TRACE

+ default-route
  + service File_system
  | + child vfs
  + any-service
    + parent
    + any-child

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer

+ start dynamic_rom
  + provides | + service ROM
  + config
    + rom test
      + inline | + foo
      + sleep  | milliseconds: 1000
      + inline | + bar
      + sleep  | milliseconds: 1000
      + inline | + baz
      + sleep  | milliseconds: 1000
      + inline | + foo
      + sleep  | milliseconds: 1000
      + inline | + bar
      + sleep  | milliseconds: 1000
      + inline | + foo
      + sleep  | milliseconds: 1000
      + inline | + bar
      + sleep  | milliseconds: 1000
      + inline | + foo
      + sleep  | milliseconds: 1000
      + inline | + bar
      + sleep  | milliseconds: 1000
      + inline | + end
      + sleep  | milliseconds: 1000

+ start rom_logger
  + config | rom: test
  + route
    + service ROM | label: test
    | + child dynamic_rom
    + any-service
      + parent

+ start dummy_rtc
  + provides | + service Rtc

+ start lx_fs | ld: no | ram: 4M
  + provides | + service File_system
  + config
    + default-policy | root: /fs | writeable: yes

+ start report_rom
  + provides
  | + service Report
  | + service ROM
  + config | verbose: yes

+ start trace_recorder | caps: 200 | ram: 16M
  + config | period_ms: 5000 | enable: yes
  | + vfs
  | | + fs
  | + policy | label_suffix: dynamic_rom | thread: dynamic_rom | policy: ctf0
  | | + ctf
  | + policy | label_suffix: rom_logger | policy: ctf0
  |   + ctf
  + route
    + service File_system | + child lx_fs
    + service TRACE       | + parent | label:
    + service ROM   | label: platform_info
    | . serve config ROM as platform_info merely to satisfy the ROM request
    | + parent | label: config
    + any-service
      + parent
      + any-child
-
}

exec rm -rf bin/fs
exec mkdir -p bin/fs

build_boot_image [list {*}[build_artifacts] fs]

append qemu_args " -nographic "

run_genode_until {Enabled ctf writer for init -> rom_logger -> ep} 20
set spawn_id [output_spawn_id]
run_genode_until {end} 60 $spawn_id

# trace file has non-zero size
exec test -s bin/fs/0-0-0\ 0\:0\:0/init/rom_logger/ep

# check generated trace by reading CTF trace as fast as possible using a dummy output
exec babeltrace2 bin/fs/0-0-0\ 0\:0\:0/init/rom_logger --output-format=dummy
